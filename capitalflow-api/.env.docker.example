# TEMPLATE ONLY. Fill secrets through your approved secret manager; never commit .env.docker.
APP_ENV=production
DEBUG=false
TELEMETRY_ENABLED=false
UPLOAD_DIR=/app/uploads
WORKER_QUEUE_LIMIT=500
# Required: existing deployment values. Preserve JOB_ENCRYPTION_KEY for existing encrypted data.
JWT_SECRET_KEY=
JOB_ENCRYPTION_KEY=
# Set ONE URL. Examples below contain placeholders, not working credentials.
DATABASE_URL=
# SQL auth: mssql+pyodbc://<URL_ENCODED_USER>:<URL_ENCODED_PASSWORD>@<SQL_FQDN>:<TCP_PORT>/<DATABASE>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
# Kerberos: mssql+pyodbc://<SQL_FQDN>:<TCP_PORT>/<DATABASE>?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&Encrypt=yes&TrustServerCertificate=no
FRONTEND_URL=https://user.example.invalid
ADMIN_URL=https://admin.example.invalid
GOOGLE_AI_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=true
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME=CapitalFlow
