APP_NAME=CapitalFlow API
APP_ENV=development
DEBUG=true

# Replace every angle-bracket placeholder. Keep credentials URL-encoded.
DATABASE_URL=mssql+pyodbc://<URL_ENCODED_USER>:<URL_ENCODED_PASSWORD>@<SQL_FQDN>:1433/<DATABASE>?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no

JWT_SECRET_KEY=change-this-to-a-strong-random-secret
JOB_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:3010
ADMIN_URL=http://localhost:5173

GOOGLE_AI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_MODEL=gemini-3.5-flash-lite

UPLOAD_DIR=uploads
